<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ЦВЕТА (имена ключей сохранены, значения изменены на светлые) -->
    <SolidColorBrush x:Key="BackgroundDark" Color="#F5F3EE"/>
    <SolidColorBrush x:Key="BackgroundCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BackgroundInput" Color="#EDE8E0"/>
    <SolidColorBrush x:Key="AccentGold" Color="#B8943A"/>
    <SolidColorBrush x:Key="AccentGoldHover" Color="#B8943A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#2D2A26"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#7A756D"/>
    <SolidColorBrush x:Key="AccentDiscount" Color="#C06040"/>
    <SolidColorBrush x:Key="White" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatusFree" Color="#5A7D4A"/>
    <SolidColorBrush x:Key="StatusBusy" Color="#B85450"/>
    <SolidColorBrush x:Key="StatusReserved" Color="#C58C40"/>

    <!-- ШРИФТЫ -->
    <FontFamily x:Key="MainFont">Segoe UI</FontFamily>

    <!-- СТИЛЬ ГЛАВНЫХ КНОПОК -->
    <Style x:Key="GoldButton" TargetType="Button">
        <Setter Property="Background" Value="#B8943A"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#B8943A"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#9E7E2E"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- СТИЛЬ ВТОРОСТЕПЕННЫХ КНОПОК -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B8943A"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderBrush" Value="#D9D3C7"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F5F3EE"/>
                <Setter Property="BorderBrush" Value="#B8943A"/>
                <Setter Property="Foreground" Value="#B8943A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- СТИЛЬ ТЕКСТОВЫХ ПОЛЕЙ (ключ DarkTextBox сохранён) -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#EDE8E0"/>
        <Setter Property="Foreground" Value="#2D2A26"/>
        <Setter Property="BorderBrush" Value="#D9D3C7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CaretBrush" Value="#B8943A"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="#B8943A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- СТИЛЬ ВЫПАДАЮЩИХ СПИСКОВ (ключ DarkComboBox сохранён) -->
    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="#EDE8E0"/>
        <Setter Property="Foreground" Value="#2D2A26"/>
        <Setter Property="BorderBrush" Value="#D9D3C7"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- СТИЛЬ ТАБЛИЦ (ключ DarkDataGrid сохранён) -->
    <Style x:Key="DarkDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#2D2A26"/>
        <Setter Property="BorderBrush" Value="#D9D3C7"/>
        <Setter Property="RowBackground" Value="#FFFFFF"/>
        <Setter Property="AlternatingRowBackground" Value="#F5F3EE"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EDE8E0"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
    </Style>

    <!-- СТИЛЬ ЗАГОЛОВКОВ ТАБЛИЦ (ключ DarkDataGridHeader сохранён) -->
    <Style x:Key="DarkDataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F5F3EE"/>
        <Setter Property="Foreground" Value="#B8943A"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderBrush" Value="#D9D3C7"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <!-- ЗАГОЛОВКИ СТРАНИЦ -->
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#B8943A"/>
    </Style>

    <Style x:Key="SubTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#2D2A26"/>
    </Style>

    <!-- КАРТОЧКИ -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#D9D3C7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,5"/>
    </Style>

</ResourceDictionary>