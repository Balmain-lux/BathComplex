<Window x:Class="BathComplex.Windows.ExpenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BathComplex.Windows"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
       Title="Добавить расход"
        Height="550" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#F5F3EE"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary Source="../Resources/Styles.xaml"/>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label x:Name="lblTitle" Content="Добавить новый расход"
               Style="{StaticResource SubTitleLabel}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <!-- Описание -->
            <Label Content="Описание расхода" Foreground="#7A756D" FontSize="13" Margin="0,5,0,0"/>
            <TextBox x:Name="txtDescription" Style="{StaticResource DarkTextBox}"
                     Text="" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

            <!-- Сумма -->
            <Label Content="Сумма (р)" Foreground="#7A756D" FontSize="13" Margin="0,10,0,0"/>
            <TextBox x:Name="txtAmount" Style="{StaticResource DarkTextBox}" Text="0"/>

            <!-- Категория -->
            <Label Content="Категория расхода" Foreground="#7A756D" FontSize="13" Margin="0,10,0,0"/>
            <ComboBox x:Name="cmbCategory" Style="{StaticResource DarkComboBox}"/>

            <!-- Дата -->
            <Label Content="Дата расхода" Foreground="#7A756D" FontSize="13" Margin="0,10,0,0"/>
            <DatePicker x:Name="dpExpenseDate" 
                        SelectedDate="{x:Static sys:DateTime.Today}"
                        Foreground="Black" Background="#EDE8E0" 
                        BorderBrush="#7A756D" BorderThickness="1"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnCancel" Content="Отмена"
                    Style="{StaticResource OutlineButton}" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Сохранить"
                    Style="{StaticResource GoldButton}" Margin="15,0,0,0" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
