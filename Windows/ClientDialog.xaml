<Window x:Class="BathComplex.Windows.ClientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BathComplex.Windows"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Добавление клиента"
        Height="550" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary Source="../Resources/Styles.xaml"/>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Label x:Name="lblTitle" Content="Добавить нового клиента"
               Style="{StaticResource SubTitleLabel}" Margin="0,0,0,20"/>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1">
            <!-- ФИО -->
            <Label Content="ФИО клиента" Foreground="#A09888" FontSize="13" Margin="0,5,0,0"/>
            <TextBox x:Name="txtFullName" Style="{StaticResource DarkTextBox}"
                     Text="" Tag="Введите полное имя"/>

            <!-- Телефон -->
            <Label Content="Номер телефона" Foreground="#A09888" FontSize="13" Margin="0,10,0,0"/>
            <TextBox x:Name="txtPhone" Style="{StaticResource DarkTextBox}"
                     Text="+7" MaxLength="15"/>

            <!-- Скидка -->
            <Label Content="Дисконтная карта (%)" Foreground="#A09888" FontSize="13" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtDiscount" Style="{StaticResource DarkTextBox}"
                         Text="0" Width="80"/>
                <Label Content="%" Foreground="#A09888" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Label Content="(0 - 100)" Foreground="#6B6B6B" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Дата регистрации -->
            <Label Content="Дата регистрации" Foreground="#A09888" FontSize="13" Margin="0,10,0,0"/>
            <DatePicker x:Name="dpRegistrationDate" 
                        SelectedDate="{x:Static sys:DateTime.Today}"
                        Foreground="Black" Background="#3C3C3C" 
                        BorderBrush="#555555" BorderThickness="1"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnCancel" Content="Отмена"
                    Style="{StaticResource OutlineButton}" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Сохранить"
                    Style="{StaticResource GoldButton}" Margin="15,0,0,0" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
