<Page x:Class="BathComplex.Pages.BookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BathComplex.Pages"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
     Title="Бронирование"
      Background="#1A1A1A">

    <Page.Resources>
        <ResourceDictionary Source="../Resources/Styles.xaml"/>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="550"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: Создание брони -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Content="Создание брони / визита" Style="{StaticResource TitleLabel}" Margin="0,0,0,10"/>

                <!-- Карточка: Клиент -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="1. Клиент" Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBox x:Name="txtClientName" Style="{StaticResource DarkTextBox}"
                                     Width="280" IsReadOnly="True" Text="Выберите клиента..."/>
                            <Button x:Name="btnSelectClient" Content="🔍 Выбрать"
                                    Style="{StaticResource GoldButton}" Margin="10,0,0,0"
                                    Click="btnSelectClient_Click"/>
                        </StackPanel>
                        <Label x:Name="lblClientInfo" Foreground="#6B6B6B" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Карточка: Апартамент и время -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="2. Апартамент и время" Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"/>

                        <Label Content="Апартамент" Foreground="#A09888" FontSize="13" Margin="0,5,0,0"/>
                        <ComboBox x:Name="cmbApartment" Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="cmbApartment_SelectionChanged"/>

                        <Label Content="Дата визита" Foreground="#A09888" FontSize="13" Margin="0,10,0,0"/>
                        <DatePicker x:Name="dpVisitDate" 
                                    SelectedDate="{x:Static sys:DateTime.Today}"
                                    SelectedDateChanged="dpVisitDate_SelectedDateChanged"/>

                        <Label Content="День недели:" Foreground="#A09888" FontSize="12" Margin="0,3,0,0"/>
                        <Label x:Name="lblDayType" Foreground="#C5A46B" FontSize="14" FontWeight="Bold"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Label Content="Время начала" Foreground="#A09888" FontSize="13"/>
                                <ComboBox x:Name="cmbStartTime" Style="{StaticResource DarkComboBox}"
                                          SelectionChanged="CalculateTotal"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Label Content="Время окончания" Foreground="#A09888" FontSize="13"/>
                                <ComboBox x:Name="cmbEndTime" Style="{StaticResource DarkComboBox}"
                                          SelectionChanged="CalculateTotal"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,10,0,0">
                            <Label Content="Стоимость апартамента:" Foreground="#A09888" FontSize="13"/>
                            <Label x:Name="lblApartmentCost" Content="0 " Foreground="#F5F0E8" FontSize="18" FontWeight="Bold"/>
                            <Label x:Name="lblPricePerHour" Foreground="#6B6B6B" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Карточка: Доп. услуги -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="3. Дополнительные услуги" Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"/>

                        <ComboBox x:Name="cmbServiceCategory" Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="cmbServiceCategory_SelectionChanged"
                                  Margin="0,5,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ComboBox x:Name="cmbService" Style="{StaticResource DarkComboBox}" Width="280"/>
                            <Button x:Name="btnAddService" Content="+ Добавить"
                                    Style="{StaticResource GoldButton}" Margin="10,0,0,0"
                                    Click="btnAddService_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="dgSelectedServices" Style="{StaticResource DarkDataGrid}"
                                  ColumnHeaderStyle="{StaticResource DarkDataGridHeader}"
                                  AutoGenerateColumns="False"
                                  Height="150" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}" Width="*"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N0} }" Width="100"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:N0} }" Width="100"/>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button x:Name="btnRemoveService" Content="✕" Click="btnRemoveService_Click"
                                                    Foreground="#B85450" Background="Transparent"
                                                    BorderThickness="0" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Карточка: Итого -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="4. Расчет стоимости" Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"/>

                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Аренда апартамента:" Foreground="#A09888" FontSize="13"/>
                            <Label x:Name="lblSubtotalApartment" Content="0 " Grid.Column="1" Foreground="#F5F0E8" FontSize="14"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Доп. услуги:" Foreground="#A09888" FontSize="13"/>
                            <Label x:Name="lblSubtotalServices" Content="0 " Grid.Column="1" Foreground="#F5F0E8" FontSize="14"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="lblDiscountLabel" Content="Скидка:" Foreground="#A09888" FontSize="13"/>
                            <Label x:Name="lblDiscount" Content="0 " Grid.Column="1" Foreground="#C06040" FontSize="14"/>
                        </Grid>

                        <Border Height="1" Background="#3C3C3C" Margin="0,8"/>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="ИТОГО К ОПЛАТЕ:" Foreground="#F5F0E8" FontSize="16" FontWeight="Bold"/>
                            <Label x:Name="lblFinalAmount" Content="0 " Grid.Column="1" 
                                   Foreground="#C5A46B" FontSize="22" FontWeight="Bold"/>
                        </Grid>

                        <Label Content="Способ оплаты" Foreground="#A09888" FontSize="13" Margin="0,15,0,0"/>
                        <ComboBox x:Name="cmbPaymentMethod" Style="{StaticResource DarkComboBox}"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Наличные"/>
                            <ComboBoxItem Content="Карта"/>
                            <ComboBoxItem Content="Перевод"/>
                        </ComboBox>

                        <Button x:Name="btnCreateBooking" Content="✅ Создать бронь / начать визит"
                                Style="{StaticResource GoldButton}" Margin="0,20,0,0"
                                Click="btnCreateBooking_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Правая панель: Активные брони / визиты -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Label Content="Активные визиты" Style="{StaticResource TitleLabel}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button x:Name="btnRefreshBookings" Content="🔄 Обновить"
                            Style="{StaticResource OutlineButton}" Click="btnRefreshBookings_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Фильтр по статусу -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="btnFilterAll" Content="Все" Style="{StaticResource OutlineButton}"
                        Width="60" Click="btnFilterAll_Click"/>
                <Button x:Name="btnFilterActive" Content="Активные" Style="{StaticResource OutlineButton}"
                        Width="90" Margin="5,0" Click="btnFilterActive_Click"/>
                <Button x:Name="btnFilterFinished" Content="Заверш." Style="{StaticResource OutlineButton}"
                        Width="90" Click="btnFilterFinished_Click"/>
            </StackPanel>

            <DataGrid x:Name="dgActiveBookings" Grid.Row="2"
                      Style="{StaticResource DarkDataGrid}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridHeader}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      SelectionChanged="dgActiveBookings_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding BookingID}" Width="40"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="120"/>
                    <DataGridTextColumn Header="Апартамент" Binding="{Binding ApartmentName}" Width="100"/>
                    <DataGridTextColumn Header="Начало" Binding="{Binding StartTime, StringFormat={}{0:dd.MM HH:mm}}" Width="100"/>
                    <DataGridTextColumn Header="Окончание" Binding="{Binding EndTime, StringFormat={}{0:dd.MM HH:mm}}" Width="100"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding FinalAmount, StringFormat={}{0:N0} }" Width="90"/>
                    <DataGridTemplateColumn Header="Статус" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Active">
                                                    <Setter Property="Background" Value="#8B6B3A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                    <Setter Property="Background" Value="#4A5E3A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Background" Value="#8B3A3A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" Foreground="#F5F0E8" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Панель управления выбранным визитом -->
            <Border x:Name="bookingControlPanel" Grid.Row="2" Background="#2D2D2D"
                    CornerRadius="6" Padding="15" Margin="0,10,0,0" Visibility="Collapsed"
                    VerticalAlignment="Bottom">
                <StackPanel>
                    <Label Content="Управление визитом" Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"/>
                    <Label x:Name="lblSelectedBookingInfo" Foreground="#A09888" FontSize="12" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnStatusBusy" Content="🔴 Занято"
                                Style="{StaticResource OutlineButton}"
                                Foreground="#B85450" BorderBrush="#B85450"
                                Width="100" Click="btnStatusBusy_Click"/>
                        <Button x:Name="btnStatusCleaning" Content="🧹 Уборка"
                                Style="{StaticResource OutlineButton}"
                                Foreground="#C58C40" BorderBrush="#C58C40"
                                Width="100" Margin="5,0" Click="btnStatusCleaning_Click"/>
                        <Button x:Name="btnStatusFree" Content="🟢 Свободно"
                                Style="{StaticResource OutlineButton}"
                                Foreground="#6B8E5A" BorderBrush="#6B8E5A"
                                Width="100" Click="btnStatusFree_Click"/>
                    </StackPanel>

                    <Button x:Name="btnFinishBooking" Content="💰 Завершить визит"
                            Style="{StaticResource GoldButton}" Margin="0,10,0,0"
                            Click="btnFinishBooking_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
