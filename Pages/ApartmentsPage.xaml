<Page x:Class="BathComplex.Pages.ApartmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BathComplex.Pages"
      mc:Ignorable="d" 
      Title="Апартаменты"
      Background="#F5F3EE">

    <Page.Resources>
        <ResourceDictionary Source="../Resources/Styles.xaml"/>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Label Content="Управление апартаментами" Style="{StaticResource TitleLabel}"/>
            <Label Content="Текущий статус всех апартаментов" Foreground="#7A756D" FontSize="14"/>
        </StackPanel>

        <!-- Панель действий -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="btnAddApartment" Content="+ Добавить апартамент"
                    Style="{StaticResource GoldButton}" Click="btnAddApartment_Click"/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить"
                    Style="{StaticResource OutlineButton}" Margin="15,0,0,0" Click="btnRefresh_Click"/>
        </StackPanel>

        <!-- Сетка апартаментов -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <DataGrid x:Name="dgApartments"
                      Style="{StaticResource DarkDataGrid}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridHeader}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ApartmentID}" Width="50"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                    <DataGridTemplateColumn Header="Текущий статус" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentStatus}" Value="Свободно">
                                                    <Setter Property="Background" Value="#5A7D4A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStatus}" Value="Занято">
                                                    <Setter Property="Background" Value="#B85450"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStatus}" Value="Бронь">
                                                    <Setter Property="Background" Value="#C58C40"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentStatus}" Value="Уборка">
                                                    <Setter Property="Background" Value="#8B6B4A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CurrentStatus}" Foreground="#2D2A26"
                                               FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Цена (будни/час)" Binding="{Binding WeekdayPrice, StringFormat={}{0:N0} }" Width="140"/>
                    <DataGridTextColumn Header="Цена (выходные/час)" Binding="{Binding WeekendPrice, StringFormat={}{0:N0} }" Width="150"/>
                    <DataGridTemplateColumn Header="Действия" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnEditApartment" Content="✏" Style="{StaticResource OutlineButton}"
                                            Width="35" Height="30" Padding="0"
                                            Click="btnEditApartment_Click"  Tag="{Binding ApartmentID}"/>
                                    <Button x:Name="btnDeleteApartment" Content="🗑" Style="{StaticResource OutlineButton}"
                                            Width="35" Height="30" Padding="0" Margin="5,0"
                                            Foreground="#B85450" BorderBrush="#B85450"
                                            Click="btnDeleteApartment_Click"  Tag="{Binding ApartmentID}"/>
                                </StackPanel>
                            </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>

        <!-- Панель визуальной сетки доступности на 2-3 дня -->
        <Border x:Name="availabilityPanel" Grid.Row="2" Background="#FFFFFF"
                CornerRadius="6" Padding="20" Margin="0,20,0,0" Visibility="Collapsed">
            <StackPanel>
                <Label Content="Сетка доступности (ближайшие 3 дня)" Style="{StaticResource SubTitleLabel}"/>
                <ItemsControl x:Name="icAvailabilityGrid" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
