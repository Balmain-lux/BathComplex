<Page x:Class="BathComplex.Pages.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BathComplex.Pages"
      mc:Ignorable="d" 
      Title="Аналитика"
      Background="#1A1A1A">

    <Page.Resources>
        <ResourceDictionary Source="../Resources/Styles.xaml"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Label Content="Аналитика и отчеты" Style="{StaticResource TitleLabel}"/>
                <Label Content="Сводная статистика по бизнесу" Foreground="#A09888" FontSize="14"/>
            </StackPanel>

            <!-- Блок 1: Ключевые показатели -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="📊 Ключевые показатели за месяц" 
                           Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"/>

                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#2A2A2A" CornerRadius="4" Padding="12" Margin="0,0,5,0">
                            <StackPanel>
                                <Label Content="Всего визитов" Foreground="#A09888" FontSize="11"/>
                                <Label x:Name="lblTotalVisits" Content="0" Foreground="#F5F0E8" 
                                       FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="4" Padding="12" Margin="0,0,5,0">
                            <StackPanel>
                                <Label Content="Средний чек" Foreground="#A09888" FontSize="11"/>
                                <Label x:Name="lblAvgCheck" Content="0 " Foreground="#F5F0E8" 
                                       FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#2A2A2A" CornerRadius="4" Padding="12" Margin="0,0,5,0">
                            <StackPanel>
                                <Label Content="Доход за месяц" Foreground="#A09888" FontSize="11"/>
                                <Label x:Name="lblMonthIncome" Content="0 " Foreground="#6B8E5A" 
                                       FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#2A2A2A" CornerRadius="4" Padding="12" Margin="0,0,5,0">
                            <StackPanel>
                                <Label Content="Расходы за месяц" Foreground="#A09888" FontSize="11"/>
                                <Label x:Name="lblMonthExpenses" Content="0 " Foreground="#B85450" 
                                       FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#2A2A2A" CornerRadius="4" Padding="12">
                            <StackPanel>
                                <Label Content="Прибыль" Foreground="#A09888" FontSize="11"/>
                                <Label x:Name="lblMonthProfit" Content="0 " Foreground="#C5A46B" 
                                       FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Блок 2: Доходы по дням (столбчатая диаграмма своими силами) -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="📈 Доходы по дням (текущий месяц)" 
                           Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"
                           Margin="0,0,0,10"/>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="icIncomeChart" Margin="0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="50" Margin="5,0" HorizontalAlignment="Center">
                                        <!-- Сумма над столбцом -->
                                        <TextBlock Text="{Binding ValueText}" 
                                                   Foreground="#F5F0E8" FontSize="10"
                                                   HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                        <!-- Столбец -->
                                        <Border Background="#3C3C3C" CornerRadius="3,3,0,0"
                                                Width="30" Height="150" HorizontalAlignment="Center">
                                            <Border Background="#C5A46B" CornerRadius="3,3,0,0"
                                                    Height="{Binding BarHeight}"
                                                    VerticalAlignment="Bottom"/>
                                        </Border>
                                        <!-- Подпись дня -->
                                        <TextBlock Text="{Binding Key}" 
                                                   Foreground="#A09888" FontSize="10"
                                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Легенда -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Border Background="#C5A46B" Width="20" Height="12" CornerRadius="2"/>
                        <Label Content="Доход " Foreground="#A09888" FontSize="11" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Блок 3: Расходы по категориям (своя круговая диаграмма) -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="📉 Расходы по категориям (текущий месяц)" 
                           Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"
                           Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Круговая диаграмма (Canvas с секторами) -->
                        <Canvas x:Name="pieCanvas" Width="220" Height="220"/>

                        <!-- Легенда -->
                        <ItemsControl x:Name="icPieLegend" Grid.Column="1" Margin="20,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Border Width="14" Height="14" CornerRadius="2" 
                                                Background="{Binding Color}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Label}" Foreground="#F5F0E8" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text=" — " Foreground="#A09888" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ValueText}" Foreground="#C5A46B" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Блок 4: Сводный финансовый отчет -->
            <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="📋 Сводный отчет по финансам" 
                           Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"/>

                    <DataGrid x:Name="dgFinanceSummary"
                              Style="{StaticResource DarkDataGrid}"
                              ColumnHeaderStyle="{StaticResource DarkDataGridHeader}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Height="350" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" 
                                               Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" 
                                               Width="120"/>
                            <DataGridTextColumn Header="Доход" 
                                               Binding="{Binding Income, StringFormat={}{0:N0} }" 
                                               Width="160"/>
                            <DataGridTextColumn Header="Расход" 
                                               Binding="{Binding Expenses, StringFormat={}{0:N0} }" 
                                               Width="160"/>
                            <DataGridTextColumn Header="Прибыль" 
                                               Binding="{Binding Profit, StringFormat={}{0:N0} }" 
                                               Width="160"/>
                            <DataGridTemplateColumn Header="Итог" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPositive}" Value="True">
                                                            <Setter Property="Background" Value="#4A5E3A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPositive}" Value="False">
                                                            <Setter Property="Background" Value="#8B3A3A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ResultText}" Foreground="#F5F0E8" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Блок 5: ТОП клиентов -->
            <Border Grid.Row="5" Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                <StackPanel>
                    <Label Content="🏆 ТОП клиентов по сумме оплат" 
                           Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"
                           Margin="0,0,0,10"/>

                    <DataGrid x:Name="dgTopClients"
                              Style="{StaticResource DarkDataGrid}"
                              ColumnHeaderStyle="{StaticResource DarkDataGridHeader}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Height="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Место" Binding="{Binding Rank}" Width="60"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="160"/>
                            <DataGridTextColumn Header="Кол-во визитов" Binding="{Binding VisitCount}" Width="120"/>
                            <DataGridTextColumn Header="Общая сумма" 
                                               Binding="{Binding TotalSpent, StringFormat={}{0:N0} }" 
                                               Width="170"/>
                            <DataGridTextColumn Header="Средний чек" 
                                               Binding="{Binding AvgCheck, StringFormat={}{0:N0} }" 
                                               Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Блок 6: Загруженность апартаментов -->
            <Border Grid.Row="6" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Label Content="🏠 Популярность апартаментов" 
                           Style="{StaticResource SubTitleLabel}" Foreground="#C5A46B"
                           Margin="0,0,0,10"/>

                    <ItemsControl x:Name="icApartmentBars" Margin="0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{Binding Name}" Foreground="#F5F0E8" FontSize="13" 
                                           VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" 
                                                 Value="{Binding OccupancyRate, Mode=OneWay}" 
                                                 Minimum="0" Maximum="100"
                                                 Height="24" 
                                                 Foreground="#C5A46B" 
                                                 Background="#3C3C3C"
                                                 BorderThickness="0"/>
                                    <Label Grid.Column="2" 
                                           Content="{Binding OccupancyRate, StringFormat={}{0:F1}%}" 
                                           Foreground="#C5A46B" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
